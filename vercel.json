{
  "name": "relichub",
  "framework": "nextjs",
  "regions": ["hkg1"],
  "env": {
    "DEMO_MODE": "true",
    "DATABASE_URL": "file:./demo.db",
    "NEXTAUTH_SECRET": "demo-secret-key-for-presentation-only",
    "NEXTAUTH_URL": "https://relichub-demo.vercel.app"
  },
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
