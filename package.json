{
  "name": "relichub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/setup-db.js && next dev --turbopack",
    "build": "node scripts/setup-db.js && npx prisma generate && next build",
    "build:demo": "DEMO_MODE=true next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "npx prisma generate",
    "vercel-build": "node scripts/vercel-build.js",
    "analyze": "cross-env ANALYZE=true next build",
    "bundle-analyzer": "npx @next/bundle-analyzer",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev",
    "db:studio": "npx prisma studio"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@ant-design/nextjs-registry": "^1.0.2",
    "@prisma/client": "^6.8.2",
    "@types/pg": "^8.15.4",
    "antd": "^5.25.4",
    "bcryptjs": "^3.0.2",
    "next": "15.3.2",
    "next-auth": "^4.24.11",
    "next-intl": "^4.1.0",
    "pg": "^8.16.0",
    "prisma": "^6.8.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^15.3.3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.50",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "cross-env": "^7.0.3",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.2",
    "postcss": "^8.5.4",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.7.2"
  }
}
